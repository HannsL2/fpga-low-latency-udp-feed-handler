# Location of BUFG Primitives
set_property LOC BUFGCTRL_X0Y3 [get_cells tx_feedback_buffer]
set_property LOC BUFGCTRL_X0Y1 [get_cells tx_clock_buffer]
set_property LOC BUFGCTRL_X0Y2 [get_cells rx_feedback_buffer]
set_property LOC BUFGCTRL_X0Y0 [get_cells rx_clock_buffer]
set_property LOC BUFGCTRL_X0Y16 [get_cells clk_50mhz_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y76 [get_ports clk_50mhz]
set_property LOC IOB_X0Y87 [get_ports eth_rx_clk]

# Clock net "tx_clock_125mhz" driven by instance "tx_clock_buffer" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_tx_clock_125mhz}
add_cells_to_pblock [get_pblocks  {CLKAG_tx_clock_125mhz}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="tx_clock_125mhz"}]]]
resize_pblock [get_pblocks {CLKAG_tx_clock_125mhz}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "rx_clock" driven by instance "rx_clock_buffer" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_rx_clock}
add_cells_to_pblock [get_pblocks  {CLKAG_rx_clock}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="rx_clock"}]]]
resize_pblock [get_pblocks {CLKAG_rx_clock}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "clk_50mhz_IBUF_BUFG" driven by instance "clk_50mhz_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_clk_50mhz_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_50mhz_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=tx_clock_manager} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_50mhz_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_clk_50mhz_IBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup
